# Copiar a .env, con permisos 600. No contiene claves reales.
# Compose fija la escucha interna y las rutas del volumen /data.
# El script añade FOLIO_LAN_IP en el primer despliegue.
MAX_UPLOAD_MB=100
LLM_MOCK=true
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_MS=120000
PDF_CONVERSION_PROVIDER=local
PDF_OCR=true
PDF_OCR_LANG=spa+eng
PDF_RENDER_COMMAND=pdftoppm

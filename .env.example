PORT=3001
# API y web usan el mismo origen; Vite redirige /api en desarrollo.
HOST=127.0.0.1
FOLIO_DATA_DIR=./data
# FOLIO_ALLOWED_ORIGINS=https://folio.example.com
GOOGLE_BOOKS_API_KEY=
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_MS=120000
LLM_MOCK=true
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Folio
MAX_UPLOAD_MB=100
TRANSLATION_REVIEW=false
PDF_CONVERSION_PROVIDER=openrouter
PDF_OPENROUTER_MODEL=google/gemini-3.8-flash
PDF_OPENROUTER_ENGINE=native
PDF_PAGES_PER_BATCH=3
PDF_TIMEOUT_MS=180000
PDF_MAX_OUTPUT_TOKENS=24000
PDF_MAX_PAGES=2000
PDF_OCR_TIMEOUT_MS=120000
PDF_OCR=true
PDF_OCR_LANG=spa+eng
PDF_RENDER_COMMAND=pdftoppm
HOST_OUTPUT_DIR=/home/baul/Descargas/ebooks

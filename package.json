{
  "name": "folio",
  "version": "0.1.0",
  "description": "Folio: taller web personal de libros digitales",
  "author": "Folio",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch apps/api/src/start.ts",
    "dev:web": "vite apps/web --host 0.0.0.0",
    "dev:device-bridge": "tsx scripts/device-bridge.ts",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:web && node scripts/build-api.mjs",
    "test": "pnpm test:e2e",
    "check:architecture": "node scripts/check-architecture.mjs",
    "preview": "vite preview apps/web --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "pdf:compare": "node --env-file-if-exists=.env --import tsx scripts/compare-pdf.ts",
    "check": "pnpm check:architecture && pnpm typecheck && pnpm test && pnpm build",
    "start": "node dist/api/start.js",
    "build:web": "vite build apps/web",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "adm-zip": "^0.5.18",
    "cheerio": "^1.2.0",
    "fastify": "^5.9.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.28.2",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^5.0.0",
    "daisyui": "^5.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.2.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
